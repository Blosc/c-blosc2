[32m+[m[32m/* The pipelines */[m
[32m+[m
[32m+[m[32mtypedef struct {[m
[32m+[m[32m  int32_t blocksize;[m
[32m+[m[32m  int32_t nblocks;      // full blocks per chunk[m
[32m+[m[32m  int32_t leftover;     // elements in the partial last block[m
