[32m+[m[32mstatic char* check_file_ends_at_frame_end(blosc2_schunk* schunk, const char* urlpath) {[m
[32m+[m[32m  /* The on-disk length; blosc2_schunk_to_buffer() would serialize a compacted copy */[m
