[32m+[m
[32m+[m[32mtypedef struct {[m
[32m+[m[32m  int tid;[m
[32m+[m[32m  int rc;[m
[32m+[m[32m} worker_state;[m
[32m+[m
[32m+[m[32mstatic blosc2_pthread_mutex_t gate_mutex;[m
[32m+[m[32mstatic blosc2_pthread_cond_t gate_cv;[m
[32m+[m[32mstatic int gate_open = 0;[m
