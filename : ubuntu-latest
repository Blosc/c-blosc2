[32m+[m[32mstatic void* first_call_worker(void *arg) {[m
[32m+[m[32m  worker_state *state = (worker_state*)arg;[m
[32m+[m[32m  uint8_t src[NBYTES], shuffled[NBYTES], back[NBYTES];[m
[32m+[m[32m  for (int i = 0; i < NBYTES; i++) {[m
[32m+[m[32m    src[i] = (uint8_t)(i * 7 + state->tid);[m
[32m+[m[32m  }[m
