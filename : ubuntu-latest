[32m+[m[32m    }[m
[32m+[m[32m  }[m
[32m+[m
[32m+[m[32m  blosc2_pthread_mutex_lock(&gate_mutex);[m
[32m+[m[32m  gate_open = 1;[m
[32m+[m[32m  blosc2_pthread_cond_broadcast(&gate_cv);[m
[32m+[m[32m  blosc2_pthread_mutex_unlock(&gate_mutex);[m
