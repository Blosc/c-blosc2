[32m+[m[32m/* Opening a frame keeps the handle that read its header as the cached reader[m
[32m+[m[32m   instead of opening the file a second time.  Whichever handle it ends up[m
[32m+[m[32m   with, an open frame must hold exactly one descriptor (none without a handle[m
[32m+[m[32m   budget) before and after its first read and none once freed, and its reads[m
[32m+[m[32m   must notice that the file was replaced. */[m
[32m+[m[32mstatic char* test_open_adopts_reader(void) {[m
[32m+[m[32m#if !defined(_WIN32)[m
[32m+[m[32m  blosc2_storage storage = {.contiguous=true, .cparams=&cparams, .dparams=&dparams};[m
[32m+[m[32m  char* urlpaths[2] = {URLPATH, URLPATH2};[m
[32m+[m[32m  for (int i = 0; i < 2; i++) {[m
[32m+[m[32m    blosc2_remove_urlpath(urlpaths[i]);[m
[32m+[m[32m    storage.urlpath = urlpaths[i];[m
[32m+[m[32m    blosc2_schunk* schunk = blosc2_schunk_new(&storage);[m
[32m+[m[32m    mu_assert("Cannot create the schunk", schunk != NULL);[m
[32m+[m[32m    for (int n = 0; n < 2; n++) {[m
[32m+[m[32m      fill(i * REPLACED_BASE + n * CHUNKSIZE, true);[m
[32m+[m[32m      mu_assert("Cannot append", blosc2_schunk_append_buffer(schunk, data, CHUNKSIZE * sizeof(int32_t)) > 0);[m
[32m+[m[32m    }[m
[32m+[m[32m    blosc2_schunk_free(schunk);[m
[32m+[m[32m  }[m
[32m+[m
[32m+[m[32m  int nfds = count_open_fds();[m
[32m+[m[32m  int cached = getenv("BLOSC_MAX_CACHED_READERS") != NULL &&[m
[32m+[m[32m               strcmp(getenv("BLOSC_MAX_CACHED_READERS"), "0") == 0 ? 0 : 1;[m
[32m+[m[32m  blosc2_schunk* schunk = blosc2_schunk_open(URLPATH);[m
[32m+[m[32m  mu_assert("Cannot open the schunk", schunk != NULL);[m
[32m+[m[32m  mu_assert("An open frame must hold at most its cached reader", count_open_fds() == nfds + cached);[m
[32m+[m[32m  // Without a budget, the frame must not ask for it on every read[m
[32m+[m[32m  mu_assert("A frame that cannot cache its reader must be flagged so",[m
[32m+[m[32m            ((blosc2_frame_s*)schunk->frame)->read_fp_nocache == (cached == 0));[m
[32m+[m[32m  int32_t nbytes = blosc2_schunk_decompress_chunk(schunk, 1, rdata, CHUNKSIZE * sizeof(int32_t));[m
[32m+[m[32m  mu_assert("Cannot decompress", nbytes == (int32_t)(CHUNKSIZE * sizeof(int32_t)));[m
[32m+[m[32m  fill(CHUNKSIZE, true);[m
[32m+[m[32m  mu_assert("Wrong chunk contents", memcmp(data, rdata, CHUNKSIZE * sizeof(int32_t)) == 0);[m
[32m+[m[32m  mu_assert("The first read must not open another handle", count_open_fds() == nfds + cached);[m
