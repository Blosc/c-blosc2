[32m+[m
[32m+[m[32mstatic int compress_chunk(blosc2_cparams cparams, int32_t nbytes, uint8_t* chunk) {[m
[32m+[m[32m  blosc2_context* cctx = blosc2_create_cctx(cparams);[m
