[32m+[m[32mstatic char* test_updates(void) {[m
[32m+[m[32m  int32_t expected[NCHUNKS + 2];[m
[32m+[m[32m  bool noisy[NCHUNKS + 2];[m
[32m+[m[32m  int nchunks = 0;[m
[32m+[m
[32m+[m[32m  blosc2_remove_urlpath(URLPATH);[m
[32m+[m[32m  blosc2_storage storage = {.contiguous=true, .urlpath=URLPATH,[m
[32m+[m[32m                            .cparams=&cparams, .dparams=&dparams};[m
[32m+[m[32m  blosc2_schunk* schunk = blosc2_schunk_new(&storage);[m
[32m+[m[32m  mu_assert("Cannot create the schunk", schunk != NULL);[m
[32m+[m[32m  mu_assert("A new frame must end at its end", check_file_ends_at_frame_end(schunk, URLPATH) == EXIT_SUCCESS);[m
[32m+[m
[32m+[m[32m  /* Grow */[m
[32m+[m[32m  for (int n = 0; n < NCHUNKS; n++) {[m
[32m+[m[32m    expected[n] = n * CHUNKSIZE;[m
[32m+[m[32m    noisy[n] = true;[m
[32m+[m[32m    fill(expected[n], noisy[n]);[m
[32m+[m[32m    mu_assert("Cannot append", blosc2_schunk_append_buffer(schunk, data, CHUNKSIZE * sizeof(int32_t)) > 0);[m
[32m+[m[32m    nchunks++;[m
[32m+[m[32m    mu_assert("append", check_file_ends_at_frame_end(schunk, URLPATH) == EXIT_SUCCESS);[m
[32m+[m[32m  }[m
[32m+[m
[32m+[m[32m  /* Update a middle chunk to a much smaller one (the tail moves down)... */[m
[32m+[m[32m  int nupdate = NCHUNKS / 2;[m
[32m+[m[32m  expected[nupdate] = 42;[m
[32m+[m[32m  noisy[nupdate] = false;[m
[32m+[m[32m  fill(expected[nupdate], noisy[nupdate]);[m
[32m+[m[32m  uint8_t* chunk = malloc(CHUNKSIZE * sizeof(int32_t) + BLOSC2_MAX_OVERHEAD);[m
[32m+[m[32m  mu_assert("Cannot compress", compress_data(schunk, chunk) > 0);[m
[32m+[m[32m  mu_assert("Cannot update", blosc2_schunk_update_chunk(schunk, nupdate, chunk, true) >= 0);[m
[32m+[m[32m  mu_assert("update (shrink)", check_file_ends_at_frame_end(schunk, URLPATH) == EXIT_SUCCESS);[m
[32m+[m[32m  mu_assert("update (shrink)", check_contents(schunk, expected, noisy, nchunks) == EXIT_SUCCESS);[m
[32m+[m
[32m+[m[32m  /* ...and back to a bigger one (the tail moves up) */[m
[32m+[m[32m  expected[nupdate] = 7 * CHUNKSIZE;[m
[32m+[m[32m  noisy[nupdate] = true;[m
[32m+[m[32m  fill(expected[nupdate], noisy[nupdate]);[m
[32m+[m[32m  mu_assert("Cannot compress", compress_data(schunk, chunk) > 0);[m
[32m+[m[32m  mu_assert("Cannot update", blosc2_schunk_update_chunk(schunk, nupdate, chunk, true) >= 0);[m
[32m+[m[32m  mu_assert("update (grow)", check_file_ends_at_frame_end(schunk, URLPATH) == EXIT_SUCCESS);[m
[32m+[m[32m  mu_assert("update (grow)", check_contents(schunk, expected, noisy, nchunks) == EXIT_SUCCESS);[m
[32m+[m
[32m+[m[32m  /* Insert at the front */[m
[32m+[m[32m  fill(-1, true);[m
[32m+[m[32m  mu_assert("Cannot compress", compress_data(schunk, chunk) > 0);[m
[32m+[m[32m  mu_assert("Cannot insert", blosc2_schunk_insert_chunk(schunk, 0, chunk, true) >= 0);[m
[32m+[m[32m  memmove(expected + 1, expected, nchunks * sizeof(int32_t));[m
[32m+[m[32m  memmove(noisy + 1, noisy, nchunks * sizeof(bool));[m
