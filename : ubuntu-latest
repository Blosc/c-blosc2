[32m+[m[32m/* The decompression pipeline gives bitunshuffle the last of the four block[m
[32m+[m[32m   temporaries of the thread_context (tmp4) instead of allocating one: a[m
[32m+[m[32m   postfilter (which runs after the filters of each block and may use the[m
[32m+[m[32m   whole temporary area, `ttmp`) fills that quarter with a pattern, and the[m
[32m+[m[32m   bitunshuffle of the next block overwrites it */[m
[32m+[m[32mtypedef struct {[m
[32m+[m[32m  int nblocks;[m
