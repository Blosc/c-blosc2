[32m+[m[32m      failed = 1;[m
[32m+[m[32m    }[m
[32m+[m[32m  }[m
[32m+[m[32m  blosc2_pthread_cond_destroy(&gate_cv);[m
[32m+[m[32m  blosc2_pthread_mutex_destroy(&gate_mutex);[m
