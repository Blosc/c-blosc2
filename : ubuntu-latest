[32m+[m[32m  blosc2_context* dctx = blosc2_create_dctx(dparams);[m
[32m+[m[32m  char* msg = check_decompression(dctx, chunk, cbytes, data, nbytes, typesize, blocksize, nthreads == 1, dest);[m
