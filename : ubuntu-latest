[32m+[m[32m#include <inttypes.h>[m
[32m+[m[32m#include <stdbool.h>[m
[32m+[m[32m#include <stdint.h>[m
[32m+[m[32m#include <stdio.h>[m
[32m+[m[32m#include <stdlib.h>[m
[32m+[m[32m#include <string.h>[m
[32m+[m
[32m+[m[32m#include "blosc2.h"[m
[32m+[m
[32m+[m[32m#define URLPATH "deferred_updates.b2frame"[m
[32m+[m[32m#define NCHUNKS 8[m
[32m+[m[32m#define CHUNK_ITEMS 4096                    // int32 items: 16 KiB per chunk before compression[m
[32m+[m[32m#define OLD_NOISE (CHUNK_ITEMS / 4)         // incompressible items in the chunks as first written...[m
[32m+[m[32m#define NEW_NOISE (5 * CHUNK_ITEMS / 16)    // ... and in their new versions, which get ~25% larger[m
[32m+[m[32m#define DRAW_WIDTH 44                       // width of the drawings, before the notes[m
[32m+[m
[32m+[m[32mtypedef struct {[m
[32m+[m[32m  int64_t offset;   // where the chunk starts in the payload[m
[32m+[m[32m  int32_t cbytes;   // its compressed size[m
[32m+[m[32m} place;[m
[32m+[m
[32m+[m[32mstatic int64_t bytes_per_char = 1;  // scale of the drawings[m
[32m+[m
[32m+[m[32m/* The data of a chunk: `noise` pseudo-random (incompressible) items, then a constant */[m
[32m+[m[32mstatic void fill_chunk(int32_t *data, int nchunk, int noise) {[m
[32m+[m[32m  uint32_t state = 2654435761u * (uint32_t)(nchunk + 1) + (uint32_t)noise;[m
[32m+[m[32m  for (int i = 0; i < CHUNK_ITEMS; i++) {[m
[32m+[m[32m    state ^= state << 13;[m
[32m+[m[32m    state ^= state >> 17;[m
[32m+[m[32m    state ^= state << 5;[m
[32m+[m[32m    data[i] = i < noise ? (int32_t)state : nchunk;[m
[32m+[m[32m  }[m
[32m+[m[32m}[m
[32m+[m
[32m+[m[32m/* Every chunk holds its new data */[m
[32m+[m[32mstatic bool check_chunks(blosc2_schunk *schunk, const char *when) {[m
[32m+[m[32m  int32_t expected[CHUNK_ITEMS];[m
[32m+[m[32m  int32_t data[CHUNK_ITEMS];[m
[32m+[m[32m  for (int i = 0; i < NCHUNKS; i++) {[m
[32m+[m[32m    fill_chunk(expected, i, NEW_NOISE);[m
[32m+[m[32m    if (blosc2_schunk_decompress_chunk(schunk, i, data, sizeof(data)) != (int)sizeof(data) ||[m
[32m+[m[32m        memcmp(data, expected, sizeof(data)) != 0) {[m
[32m+[m[32m      fprintf(stderr, "Chunk %c is wrong %s\n", 'A' + i, when);[m
[32m+[m[32m      return false;[m
[32m+[m[32m    }[m
[32m+[m[32m  }[m
[32m+[m[32m  return true;[m
[32m+[m[32m}[m
[32m+[m
[32m+[m[32m/* Where every chunk lies in the payload: blosc2_frame_get_offsets() gives the offsets, and the[m
[32m+[m[32m   header of each chunk its compressed size. */[m
[32m+[m[32mstatic int get_layout(blosc2_schunk *schunk, place *layout) {[m
[32m+[m[32m  int64_t *offsets = blosc2_frame_get_offsets(schunk);[m
[32m+[m[32m  if (offsets == NULL) {[m
[32m+[m[32m    return -1;[m
[32m+[m[32m  }[m
[32m+[m[32m  for (int i = 0; i < NCHUNKS; i++) {[m
[32m+[m[32m    uint8_t *chunk;[m
[32m+[m[32m    bool needs_free;[m
[32m+[m[32m    int rc = blosc2_schunk_get_lazychunk(schunk, i, &chunk, &needs_free);[m
[32m+[m[32m    if (rc >= 0) {[m
[32m+[m[32m      layout[i].offset = offsets[i];[m
[32m+[m[32m      rc = blosc2_cbuffer_sizes(chunk, NULL, &layout[i].cbytes, NULL);[m
[32m+[m[32m      if (needs_free) {[m
[32m+[m[32m        free(chunk);[m
[32m+[m[32m      }[m
[32m+[m[32m    }[m
[32m+[m[32m    if (rc < 0) {[m
[32m+[m[32m      free(offsets);[m
[32m+[m[32m      return rc;[m
[32m+[m[32m    }[m
[32m+[m[32m  }[m
[32m+[m[32m  free(offsets);[m
[32m+[m[32m  return 0;[m
[32m+[m[32m}[m
[32m+[m
[32m+[m[32m/* Draw `c` from column *col up to the column where payload byte `end` falls */[m
[32m+[m[32mstatic void draw_run(char c, int64_t end, int *col) {[m
[32m+[m[32m  int end_col = (int)((end + bytes_per_char / 2) / bytes_per_char);[m
[32m+[m[32m  for (; *col < end_col; (*col)++) {[m
[32m+[m[32m    putchar(c);[m
[32m+[m[32m  }[m
[32m+[m[32m}[m
[32m+[m
[32m+[m[32m/* Draw the payload, one character per bytes_per_char bytes: the letter of the chunk stored there, or '.'[m
[32m+[m[32m   for free space.  Then the note. */[m
[32m+[m[32mstatic void draw(const char *label, const place *layout, int64_t payload_len, const char *note) {[m
[32m+[m[32m  printf("  %-14s ", label);[m
[32m+[m[32m  int col = 0;[m
[32m+[m[32m  int64_t pos = 0;  // payload drawn up to here[m
[32m+[m[32m  while (true) {[m
[32m+[m[32m    int next = -1;  // the next chunk in the payload[m
[32m+[m[32m    for (int i = 0; i < NCHUNKS; i++) {[m
[32m+[m[32m      if (layout[i].offset >= pos && (next < 0 || layout[i].offset < layout[next].offset)) {[m
[32m+[m[32m        next = i;[m
[32m+[m[32m      }[m
[32m+[m[32m    }[m
[32m+[m[32m    draw_run('.', next < 0 ? payload_len : layout[next].offset, &col);[m
[32m+[m[32m    if (next < 0) {[m
[32m+[m[32m      break;[m
[32m+[m[32m    }[m
[32m+[m[32m    pos = layout[next].offset + layout[next].cbytes;[m
[32m+[m[32m    draw_run((char)('A' + next), pos, &col);[m
[32m+[m[32m  }[m
[32m+[m[32m  printf("%*s%s\n", col < DRAW_WIDTH ? DRAW_WIDTH - col : 1, "", note);[m
[32m+[m[32m}[m
[32m+[m
[32m+[m[32m/* Bytes of the chunks other than `except` that changed place between two layouts */[m
[32m+[m[32mstatic int64_t bytes_moved(const place *before, const place *after, int except) {[m
[32m+[m[32m  int64_t moved = 0;[m
[32m+[m[32m  for (int i = 0; i < NCHUNKS; i++) {[m
[32m+[m[32m    if (i != except && after[i].offset != before[i].offset) {[m
[32m+[m[32m      moved += after[i].cbytes;[m
[32m+[m[32m    }[m
[32m+[m[32m  }[m
[32m+[m[32m  return moved;[m
[32m+[m[32m}[m
[32m+[m
[32m+[m[32m/* Write a frame on disk, overwrite all its chunks with their new versions (inside a bracket or not),[m
[32m+[m[32m   and check them.  Returns the final payload length, or -1 on errors. */[m
[32m+[m[32mstatic int64_t overwrite_all(bool bracket) {[m
[32m+[m[32m  int32_t data[CHUNK_ITEMS];[m
[32m+[m[32m  place before[NCHUNKS];[m
[32m+[m[32m  place after[NCHUNKS];[m
[32m+[m[32m  char note[64];[m
[32m+[m[32m  bool updating = false;[m
[32m+[m[32m  int64_t total_moved = 0;[m
[32m+[m[32m  int64_t result = -1;[m
[32m+[m
[32m+[m[32m  blosc2_cparams cparams = BLOSC2_CPARAMS_DEFAULTS;[m
[32m+[m[32m  cparams.typesize = sizeof(int32_t);[m
[32m+[m[32m  cparams.compcode = BLOSC_LZ4;[m
[32m+[m[32m  blosc2_storage storage = {.contiguous = true, .urlpath = URLPATH, .cparams = &cparams};[m
[32m+[m[32m  blosc2_remove_urlpath(URLPATH);[m
[32m+[m[32m  blosc2_schunk *schunk = blosc2_schunk_new(&storage);[m
[32m+[m[32m  if (schunk == NULL) {[m
[32m+[m[32m    fprintf(stderr, "Cannot create the super-chunk\n");[m
[32m+[m[32m    return -1;[m
[32m+[m[32m  }[m
[32m+[m[32m  for (int i = 0; i < NCHUNKS; i++) {[m
[32m+[m[32m    fill_chunk(data, i, OLD_NOISE);[m
[32m+[m[32m    if (blosc2_schunk_append_buffer(schunk, data, sizeof(data)) < 0) {[m
[32m+[m[32m      fprintf(stderr, "Cannot append chunk %c\n", 'A' + i);[m
[32m+[m[32m      goto out;[m
[32m+[m[32m    }[m
[32m+[m[32m  }[m
[32m+[m[32m  if (get_layout(schunk, before) < 0) {[m
[32m+[m[32m    goto out;[m
[32m+[m[32m  }[m
[32m+[m[32m  bytes_per_char = before[0].cbytes / 4;[m
[32m+[m[32m  snprintf(note, sizeof(note), "(1 character: %" PRId64 " bytes)", bytes_per_char);[m
[32m+[m[32m  draw("as written", before, schunk->cbytes, note);[m
[32m+[m
[32m+[m[32m  // From here on, an update moves no other chunk; the free space it leaves stays until[m
[32m+[m[32m  // blosc2_schunk_end_updates().  This also takes the exclusive frame lock.[m
[32m+[m[32m  if (bracket) {[m
[32m+[m[32m    if (blosc2_schunk_begin_updates(schunk) < 0) {[m
[32m+[m[32m      fprintf(stderr, "Cannot begin the updates\n");[m
[32m+[m[32m      goto out;[m
[32m+[m[32m    }[m
[32m+[m[32m    updating = true;[m
[32m+[m[32m  }[m
[32m+[m
[32m+[m[32m  for (int i = 0; i < NCHUNKS; i++) {[m
[32m+[m[32m    fill_chunk(data, i, NEW_NOISE);[m
[32m+[m[32m    if (blosc2_schunk_update_buffer(schunk, i, data, sizeof(data)) < 0) {[m
[32m+[m[32m      fprintf(stderr, "Cannot update chunk %c\n", 'A' + i);[m
[32m+[m[32m      goto out;[m
[32m+[m[32m    }[m
[32m+[m[32m    if (get_layout(schunk, after) < 0) {[m
[32m+[m[32m      goto out;[m
[32m+[m[32m    }[m
[32m+[m[32m    int64_t moved = bytes_moved(before, after, i);[m
[32m+[m[32m    total_moved += moved;[m
[32m+[m[32m    char label[16];[m
[32m+[m[32m    snprintf(label, sizeof(label), "update %c", 'A' + i);[m
[32m+[m[32m    snprintf(note, sizeof(note), "moved %" PRId64 " bytes", moved);[m
[32m+[m[32m    draw(label, after, schunk->cbytes, note);[m
[32m+[m[32m    memcpy(before, after, sizeof(after));[m
[32m+[m[32m  }[m
[32m+[m
[32m+[m[32m  if (bracket) {[m
[32m+[m[32m    // The frame is valid inside the bracket: every chunk reads back from wherever it lies now[m
[32m+[m[32m    if (!check_chunks(schunk, "inside the bracket")) {[m
[32m+[m[32m      goto out;[m
[32m+[m[32m    }[m
[32m+[m
[32m+[m[32m    // Close the free space in one pass (every chunk moves at most once) and release the lock[m
[32m+[m[32m    int64_t payload_inside = schunk->cbytes;[m
[32m+[m[32m    updating = false;[m
[32m+[m[32m    if (blosc2_schunk_end_updates(schunk) < 0) {[m
[32m+[m[32m      fprintf(stderr, "Cannot end the updates\n");[m
[32m+[m[32m      goto out;[m
[32m+[m[32m    }[m
[32m+[m[32m    if (get_layout(schunk, after) < 0) {[m
[32m+[m[32m      goto out;[m
[32m+[m[32m    }[m
[32m+[m[32m    int64_t moved = bytes_moved(before, after, -1);[m
[32m+[m[32m    total_moved += moved;[m
[32m+[m[32m    snprintf(note, sizeof(note), "moved %" PRId64 " bytes", moved);[m
[32m+[m[32m    draw("end_updates()", after, schunk->cbytes, note);[m
[32m+[m[32m    printf("  (the payload shrank from %" PRId64 " to %" PRId64 " bytes)\n", payload_inside,[m
[32m+[m[32m           schunk->cbytes);[m
[32m+[m[32m  }[m
[32m+[m[32m  printf("  moved %" PRId64 " bytes in all, for a payload of %" PRId64 " bytes\n", total_moved,[m
[32m+[m[32m         schunk->cbytes);[m
[32m+[m
[32m+[m[32m  // The file holds the new data[m
[32m+[m[32m  blosc2_schunk_free(schunk);[m
[32m+[m[32m  schunk = blosc2_schunk_open(URLPATH);[m
