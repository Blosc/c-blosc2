[32m+[m[32m#define NLAZY_SHAPES 2[m
[32m+[m
[32m+[m[32mstatic const int32_t typesizes[] = {1, 2, 3, 4, 8, 16};[m
[32m+[m
[32m+[m[32mstatic const uint8_t filter_sets[][BLOSC2_MAX_FILTERS] = {[m
[32m+[m[32m    {0, 0, 0, 0, 0, BLOSC_BITSHUFFLE},[m
[32m+[m[32m    {0, 0, 0, 0, BLOSC_DELTA, BLOSC_BITSHUFFLE},[m
[32m+[m[32m    {0, 0, 0, 0, BLOSC_BITSHUFFLE, BLOSC_SHUFFLE},[m
[32m+[m[32m};[m
[32m+[m[32m#define NFILTER_SETS ((int)ARRAY_SIZE(filter_sets))[m
[32m+[m
[32m+[m[32mstatic const int16_t nthreads_list[] = {1, 4};[m
[32m+[m
[32m+[m
[32m+[m[32mstatic void shape_sizes(const chunk_shape* shape, int32_t typesize, int32_t* blocksize, int32_t* nbytes) {[m
[32m+[m[32m  *blocksize = shape->blocksize / typesize * typesize;[m
[32m+[m[32m  *nbytes = shape->nblocks * *blocksize + shape->leftover * typesize;[m
[32m+[m[32m}[m
[32m+[m
[32m+[m
[32m+[m[32mstatic int copy_prefilter(blosc2_prefilter_params* params) {[m
[32m+[m[32m  memcpy(params->output, params->input, params->output_size);[m
[32m+[m[32m  return 0;[m
[32m+[m[32m}[m
[32m+[m
[32m+[m
[32m+[m[32mstatic int copy_postfilter(blosc2_postfilter_params* params) {[m
[32m+[m[32m  memcpy(params->output, params->input, params->size);[m
[32m+[m[32m  return 0;[m
