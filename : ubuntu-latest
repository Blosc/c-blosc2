[32m+[m[32m  mu_assert("ERROR: getitem does not restore the data",[m
[32m+[m[32m            memcmp(dest, src + start * typesize, (size_t)nitems * typesize) == 0);[m
[32m+[m[32m  return EXIT_SUCCESS;[m
[32m+[m[32m}[m
