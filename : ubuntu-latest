[32m+[m[32m                                    offsets[3] < offsets[5] && offsets[5] < offsets[0] && offsets[0] < offsets[4]);[m
[32m+[m[32m  free(offsets);[m
[32m+[m[32m  free(before);[m
[32m+[m[32m  blosc2_schunk_free(schunk);[m
[32m+[m[32m  blosc2_remove_urlpath(urlpath);[m
[32m+[m[32m  return EXIT_SUCCESS;[m
[32m+[m[32m}[m
