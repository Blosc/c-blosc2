[32m+[m[32m    int64_t slab_nitems = slab_shape[0] * slab_shape[1] * slab_shape[2];[m
[32m+[m[32m    int32_t* slab = malloc((size_t)slab_nitems * sizeof(int32_t));[m
[32m+[m[32m    for (int64_t i = 0; i < slab_nitems; i++) {[m
