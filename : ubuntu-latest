[32m+[m[32m/* One block of 768 KB per chunk (the case that made every read page-fault),[m
[32m+[m[32m   blocks of 256 KB (and 256 KB - 1 for odd typesizes) with a partial last[m
[32m+[m[32m   block whose elements are not a multiple of 8, small blocks */[m
[32m+[m[32mstatic const chunk_shape shapes[] = {[m
[32m+[m[32m    {768 * 1024, 1, 0},[m
[32m+[m[32m    {256 * 1024, 3, 8 * 1000 + 5},[m
[32m+[m[32m    {32 * 1024, 6, 8 * 100 + 3},[m
[32m+[m[32m};[m
