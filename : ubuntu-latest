[32m+[m
[32m+[m[32m    mu_assert("ERROR: get_slice failed", b2nd_get_slice_cbuffer(array, start, shape, back, shape, nbytes) == 0);[m
[32m+[m[32m    mu_assert("ERROR: wrong data", memcmp(back, data, (size_t)nbytes) == 0);[m
[32m+[m[32m    mu_assert("ERROR: frame not compact", check_compact(array->sc));[m
[32m+[m[32m    // The same data, written into a new in-memory array at once[m
[32m+[m[32m    blosc2_storage fresh_storage = {.contiguous = true, .cparams = &cparams};[m
[32m+[m[32m    b2nd_context_t* fresh_ctx = b2nd_create_ctx(&fresh_storage, 3, shape, chunkshape, blockshape, NULL, 0,[m
[32m+[m[32m                                                NULL, 0);[m
