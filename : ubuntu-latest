[32m+[m[32m  }[m
[32m+[m
[32m+[m[32m  // An orthogonal selection over several chunks[m
[32m+[m[32m  int64_t sel0[] = {1, 9, 17, 33};[m
[32m+[m[32m  int64_t sel1[] = {0, 30, 47};[m
[32m+[m[32m  int64_t sel2[] = {2, 25};[m
[32m+[m[32m  int64_t* selection[3] = {sel0, sel1, sel2};[m
