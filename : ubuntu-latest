[32m+[m[32m  dparams.nthreads = nthreads;[m
[32m+[m[32m  blosc2_postfilter_params postparams = {0};[m
[32m+[m[32m  if (callbacks) {[m
[32m+[m[32m    cparams.prefilter = copy_prefilter;[m
[32m+[m[32m    cparams.preparams = &preparams;[m
[32m+[m[32m    dparams.postfilter = copy_postfilter;[m
[32m+[m[32m    dparams.postparams = &postparams;[m
