[32m+[m[32m  mu_assert("Cannot delete", blosc2_schunk_delete_chunk(schunk, 0) >= 0);[m
[32m+[m[32m  memmove(expected, expected + 1, (nchunks - 1) * sizeof(int32_t));[m
[32m+[m[32m  memmove(noisy, noisy + 1, (nchunks - 1) * sizeof(bool));[m
[32m+[m[32m  nchunks--;[m
[32m+[m[32m  mu_assert("delete after reopen", check_file_ends_at_frame_end(schunk, URLPATH) == EXIT_SUCCESS);[m
[32m+[m[32m  mu_assert("after reopen", check_contents(schunk, expected, noisy, nchunks) == EXIT_SUCCESS);[m
[32m+[m[32m  blosc2_schunk_free(schunk);[m
[32m+[m
[32m+[m[32m  schunk = blosc2_schunk_open(URLPATH);[m
[32m+[m[32m  mu_assert("Cannot reopen", schunk != NULL);[m
[32m+[m[32m  mu_assert("final reopen", check_contents(schunk, expected, noisy, nchunks) == EXIT_SUCCESS);[m
[32m+[m[32m  blosc2_schunk_free(schunk);[m
[32m+[m[32m  free(chunk);[m
[32m+[m[32m  blosc2_remove_urlpath(URLPATH);[m
[32m+[m[32m  return EXIT_SUCCESS;[m
[32m+[m[32m}[m
