[32m+[m[32m                                                                 array) == 0);[m
[32m+[m[32m    for (int64_t i = 0; i < slab_nitems; i++) {[m
[32m+[m[32m      int64_t z = i / (slab_shape[1] * slab_shape[2]);[m
[32m+[m[32m      int64_t y = (i / slab_shape[2]) % slab_shape[1];[m
