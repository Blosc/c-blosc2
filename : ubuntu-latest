[32m+[m[32m|---|---:|---:|---:|---:|[m
[32m+[m[32m| arange float32 | 1 | 427.22 ms | 408.30 ms | 1.046x |[m
[32m+[m[32m| arange float32 | 5 | 425.63 ms | 408.23 ms | 1.043x |[m
[32m+[m[32m| arange float64 | 1 | 211.78 ms | 166.64 ms | 1.271x |[m
[32m+[m[32m| arange float64 | 5 | 211.24 ms | 166.27 ms | 1.271x |[m
[32m+[m[32m| linspace float32 | 1 | 446.50 ms | 427.46 ms | 1.045x |[m
[32m+[m[32m| linspace float32 | 5 | 446.72 ms | 427.81 ms | 1.044x |[m
[32m+[m[32m| linspace float64 | 1 | 384.06 ms | 365.34 ms | 1.051x |[m
[32m+[m[32m| linspace float64 | 5 | 380.65 ms | 360.99 ms | 1.054x |[m
