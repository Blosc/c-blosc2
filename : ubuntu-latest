[32m+[m[32m/* b2nd writes on an existing array: the result is as compact as the same data written into a new array */[m
[32m+[m[32mstatic char* b2nd_overwrite(const char* urlpath) {[m
[32m+[m[32m  blosc2_remove_urlpath(urlpath);[m
[32m+[m[32m  int64_t shape[3] = {40, 48, 40};[m
[32m+[m[32m  int32_t chunkshape[3] = {8, 24, 20};[m
[32m+[m[32m  int32_t blockshape[3] = {4, 12, 10};[m
[32m+[m[32m  int64_t nitems = shape[0] * shape[1] * shape[2];[m
[32m+[m[32m  int64_t nbytes = nitems * (int64_t)sizeof(int32_t);[m
[32m+[m[32m  int32_t* data = malloc((size_t)nbytes);[m
[32m+[m[32m  int32_t* back = malloc((size_t)nbytes);[m
[32m+[m[32m  blosc2_cparams cparams = BLOSC2_CPARAMS_DEFAULTS;[m
[32m+[m[32m  cparams.typesize = sizeof(int32_t);[m
[32m+[m[32m  cparams.nthreads = 2;[m
