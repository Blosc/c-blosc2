[32m+[m[32m  mu_assert("insert", check_contents(schunk, expected, noisy, nchunks) == EXIT_SUCCESS);[m
[32m+[m
[32m+[m[32m  /* Shrink: delete the last two chunks, so the file must be cut */[m
[32m+[m[32m  for (int i = 0; i < 2; i++) {[m
[32m+[m[32m    mu_assert("Cannot delete", blosc2_schunk_delete_chunk(schunk, nchunks - 1) >= 0);[m
[32m+[m[32m    nchunks--;[m
