[32m+[m[32m  blosc2_remove_urlpath(URLPATH);[m
[32m+[m[32m  mu_assert("Cannot move the replacement in place", rename(URLPATH2, URLPATH) == 0);[m
[32m+[m[32m  nbytes = blosc2_schunk_decompress_chunk(schunk, 1, rdata, CHUNKSIZE * sizeof(int32_t));[m
[32m+[m[32m  mu_assert("Cannot decompress", nbytes == (int32_t)(CHUNKSIZE * sizeof(int32_t)));[m
[32m+[m[32m  fill(REPLACED_BASE + CHUNKSIZE, true);[m
[32m+[m[32m  mu_assert("Reads must see the replacement", memcmp(data, rdata, CHUNKSIZE * sizeof(int32_t)) == 0);[m
