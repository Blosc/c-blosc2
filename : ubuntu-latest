[32m+[m[32m  free(offsets);[m
[32m+[m[32m  int64_t end = schunk->cbytes;[m
[32m+[m
[32m+[m[32m  // The last chunk grows in place[m
[32m+[m[32m  model[0] = (chunk_model){.kind = KIND_RANDOM, .seed = 20};[m
[32m+[m[32m  blosc2_schunk_update_chunk(schunk, 0, make_chunk(schunk, model[0]), false);[m
[32m+[m[32m  offsets = blosc2_frame_get_offsets(schunk);[m
[32m+[m[32m  mu_assert("ERROR: the last chunk moved", offsets[0] == payload && schunk->cbytes > end);[m
[32m+[m[32m  free(offsets);[m
[32m+[m[32m  end = schunk->cbytes;[m
[32m+[m
[32m+[m[32m  // A chunk becomes special: its place is a hole; a special chunk becomes regular: at the end[m
[32m+[m[32m  model[4] = (chunk_model){.kind = KIND_ZEROS};[m
[32m+[m[32m  blosc2_schunk_update_chunk(schunk, 4, make_chunk(schunk, model[4]), false);[m
[32m+[m[32m  model[4] = (chunk_model){.kind = KIND_HALF, .seed = 14};[m
