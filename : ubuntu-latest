[32m+[m
[32m+[m[32m  // A larger chunk 0 does not fit (no hole next to it): it goes to the end[m
[32m+[m[32m  model[0] = (chunk_model){.kind = KIND_3QUARTERS, .seed = 10};[m
[32m+[m[32m  blosc2_schunk_update_chunk(schunk, 0, make_chunk(schunk, model[0]), false);[m
[32m+[m[32m  offsets = blosc2_frame_get_offsets(schunk);[m
