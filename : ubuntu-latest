[32m+[m
[32m+[m[32m  int64_t start[3] = {0, 0, 0};[m
[32m+[m[32m  for (int pass = 0; pass < 8; pass++) {[m
[32m+[m[32m    // Full writes and slabs, with data whose compressibility differs from chunk to chunk and pass to pass[m
[32m+[m[32m    int64_t lo[3] = {0, 0, 0};[m
[32m+[m[32m    int64_t hi[3] = {shape[0], shape[1], shape[2]};[m
[32m+[m[32m    if (pass % 2 == 1) {[m
[32m+[m[32m      lo[0] = 5 + pass;[m
[32m+[m[32m      hi[0] = 30;[m
