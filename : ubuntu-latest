[32m+[m[32m   for the first initialization; the inverse checks the result. */[m
[32m+[m[32mstatic const struct {[m
[32m+[m[32m  shuffle_fn first;[m
[32m+[m[32m  shuffle_fn inverse;[m
[32m+[m[32m} ops[] = {[m
[32m+[m[32m  {blosc2_shuffle, blosc2_unshuffle},[m
[32m+[m[32m  {blosc2_unshuffle, blosc2_shuffle},[m
[32m+[m[32m  {blosc2_bitshuffle, blosc2_bitunshuffle},[m
[32m+[m[32m  {blosc2_bitunshuffle, blosc2_bitshuffle},[m
[32m+[m[32m};[m
