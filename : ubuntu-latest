[32m+[m[32m  mu_assert("delete", check_contents(schunk, expected, noisy, nchunks) == EXIT_SUCCESS);[m
[32m+[m[32m  blosc2_schunk_free(schunk);[m
[32m+[m
[32m+[m[32m  /* Reopen (the file size is unknown to the new handle) and grow, then shrink again */[m
[32m+[m[32m  schunk = blosc2_schunk_open(URLPATH);[m
[32m+[m[32m  mu_assert("Cannot reopen", schunk != NULL);[m
[32m+[m[32m  mu_assert("reopen", check_contents(schunk, expected, noisy, nchunks) == EXIT_SUCCESS);[m
[32m+[m[32m  expected[nchunks] = 9 * CHUNKSIZE;[m
[32m+[m[32m  noisy[nchunks] = true;[m
[32m+[m[32m  fill(expected[nchunks], true);[m
[32m+[m[32m  mu_assert("Cannot append", blosc2_schunk_append_buffer(schunk, data, CHUNKSIZE * sizeof(int32_t)) > 0);[m
[32m+[m[32m  nchunks++;[m
