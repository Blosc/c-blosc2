[32m+[m[32m  blosc2_pthread_cond_init(&gate_cv, NULL);[m
[32m+[m[32m  for (int t = 0; t < NTHREADS; t++) {[m
[32m+[m[32m    states[t].tid = t;[m
[32m+[m[32m    if (blosc2_pthread_create(&threads[t], NULL, first_call_worker, &states[t]) != 0) {[m
