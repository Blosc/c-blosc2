[32m+[m
[32m+[m[32m/* Decompress `chunk` with `dctx` and compare with `src`; with `getitem`,[m
[32m+[m[32m   also from the middle of the second block (getitem works serially) */[m
[32m+[m[32mstatic char* check_decompression(blosc2_context* dctx, const uint8_t* chunk, int32_t cbytes,[m
[32m+[m[32m                                 const uint8_t* src, int32_t nbytes, int32_t typesize,[m
[32m+[m[32m                                 int32_t blocksize, bool getitem, uint8_t* dest) {[m
